  "flags": {
    "DAVE_ENABLE_EXTENDED_TOOLS": {
      "default": false,
      "description": "Registers the extended tools: bounded reads, plus file.edit, which needs approval for every call. Honored only with DAVE_ENABLE_TOOLS.",
      "tools": [
        "chat.search",
        "cluster.status",
        "file.edit",
        "file.list",
        "file.read_lines",
        "file.search",
        "git.diff",
        "git.log",
        "git.show",
        "git.status",
        "md.outline",
        "md.section",
        "project.artifacts",
        "project.brain.read",
        "project.notepad.read"
      ]
    },
    "DAVE_ENABLE_SHELL_TOOL": {
      "default": false,
      "description": "Registers shell.exec. Execution still needs DAVE_ENABLE_TOOLS.",
      "tools": [
        "shell.exec"
      ]
    },
    "DAVE_ENABLE_TOOLS": {
      "default": false,
      "description": "Turns on tool execution and the core tools.",
      "tools": [
        "file.append",
        "file.read",
        "file.write",
        "system.info",
        "web.fetch"
      ]
    },
    "DAVE_TOOL_ROOTS": {
      "default": [],
      "description": "JSON array of absolute folders that file and Git tools may use.",
      "tools": []
    }
