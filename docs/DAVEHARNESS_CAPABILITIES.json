    {
      "authentication": "X-API-Key",
      "endpoint": "get_agent_run_events",
      "methods": [
        "GET"
      ],
      "path": "/tools/agent/runs/{run_id}/events"
    },
    {
      "authentication": "X-API-Key",
      "endpoint": "execute_tool_endpoint",
      "methods": [
        "POST"
      ],
      "path": "/tools/execute"
    }
  ],
  "runs": {
    "budget": {
      "errors": 2,
      "event_count": 1000,
      "model_steps": 8,
      "tool_calls": 32,
      "tool_output_bytes": 65536,
      "total_wall_seconds": 300.0,
      "transcript_bytes": 2097152
